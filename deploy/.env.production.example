# Kaskad — production (utilisé par docker compose ET par l'API). Ne jamais committer le fichier rempli.

# --- Domaines (enregistrements DNS A/AAAA vers le serveur)
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
FILES_DOMAIN=files.example.com
ACME_EMAIL=ops@example.com

# --- Secrets (générer : openssl rand -hex 32)
JWT_SECRET=
MONGO_ROOT_USER=kaskad
MONGO_ROOT_PASSWORD=
MINIO_ROOT_USER=kaskad
MINIO_ROOT_PASSWORD=

# --- Administrateur de la plateforme (créé au premier démarrage)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_REQUIRE_2FA=true

# --- E-mails (Brevo)
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Kaskad

# --- Antivirus complémentaire (facultatif)
VIRUSTOTAL_API_KEY=

# --- Pages publiques et app Kaskad
PUBLIC_WEB_URL=
KASKAD_DOWNLOAD_URL=
ANDROID_PACKAGE_ID=com.kaskad.store

# --- Statistiques par pays (facultatif) : en-tête d'un CDN (CF-IPCountry) ou base locale montée dans ./geoip
GEOIP_HEADER=
GEOIP_DATABASE=

# --- Notifications push (facultatif) : fichiers dans ./secrets
FIREBASE_CREDENTIALS_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_USE_SANDBOX=false
