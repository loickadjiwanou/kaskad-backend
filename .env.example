# --- General
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
# Public web pages of the apps (/a/<id>, shareable links). Empty = PUBLIC_BASE_URL
PUBLIC_WEB_URL=
# Where to download Kaskad (button on public pages). Empty = button hidden
KASKAD_DOWNLOAD_URL=
# Android package of the Kaskad client (opens the app from public pages on Android)
ANDROID_PACKAGE_ID=com.kaskad.store

# Statistics by country: CDN header (e.g. CF-IPCountry) or local GeoLite2 / DB-IP .mmdb file
GEOIP_HEADER=
GEOIP_DATABASE=
CORS_ORIGINS=["http://localhost:8081","http://localhost:5173","kaskad://app"]

# --- MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kaskad
# Credentials (leave empty if MongoDB has no authentication)
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# --- Auth (JWT_SECRET: random string, at least 32 characters in production)
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Two-step verification required for the platform admin (set to false to skip it in development)
ADMIN_REQUIRE_2FA=true

# --- Emails (Brevo): sign-up confirmation and team invitations
# Without Brevo settings, emails are only written to the API logs (development)
# Option 1: Brevo SMTP relay (SMTP & API > SMTP tab: server, port, login, SMTP key "xsmtpsib-...")
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Option 2: Brevo HTTP API key ("xkeysib-..."), used instead of SMTP when set
BREVO_API_KEY=
# Sender (must be validated in Brevo: Senders, domains & dedicated IPs)
MAIL_SENDER_EMAIL=no-reply@example.com
MAIL_SENDER_NAME=Kaskad
# Console address used in email links
CONSOLE_URL=http://localhost:5173

# --- Storage: "local" (dev) or "s3" (MinIO / Backblaze B2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=
# S3_BUCKET=kaskad
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
DOWNLOAD_URL_TTL_SECONDS=600
MAX_UPLOAD_SIZE_MB=2048

# --- Security scan
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# VIRUSTOTAL_API_KEY=
SCAN_REQUIRE_ANTIVIRUS=false
REQUIRE_AUTHENTICODE=false

# --- Push notifications
# FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
# APNS_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.kaskad.store
# APNS_USE_SANDBOX=true
